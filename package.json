    "@mui/material": "^5.14.16",
    "@mui/x-date-pickers": "^6.18.6",
    "@reactour/tour": "^3.8.0",
    "@reduxjs/toolkit": "^1.9.7",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.6",
    "@vercel/analytics": "^1.2.2",
    "dayjs": "^1.11.13",
    "dayjs-plugin-utc": "^0.1.2",
    "dayjs-timezone-iana-plugin": "^0.1.0",
    "firebase": "^10.5.0",
