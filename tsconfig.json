{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*", "../../../../../*"],
      "@firebase/*": [
        "../../../../../firebase/*",
        "../../../../firebase/*",
        "../../../firebase/*",
        "../../firebase/*",
        "../firebase/*",
        "./firebase/*"
      ],
      "@models/*": [
        "../../../../../models/*",
        "../../../../models/*",
        "../../../models/*",
        "../../models/*",
        "../models/*",
        "./models/*"
      ]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
